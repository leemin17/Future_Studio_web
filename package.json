{
  "name": "future-studio",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,yellow \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run typecheck -w backend && npm run build -w frontend",
    "migrate:supabase": "tsx scripts/migrate-data-to-supabase.ts",
    "test": "npm run test:e2e",
    "test:unit": "npm run test -w backend && vitest run --config frontend/vitest.config.ts",
    "test:unit:watch": "vitest --config frontend/vitest.config.ts",
    "storybook": "storybook dev -p 6006 -c frontend/.storybook",
    "build:storybook": "storybook build -c frontend/.storybook -o frontend/storybook-static",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/react-vite": "latest",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "storybook": "latest",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "@tanstack/react-query": "^5.101.2",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/react": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "radix-ui": "^1.6.3",
    "react-hook-form": "^7.82.0",
    "zod": "^4.4.3"
  }
}
