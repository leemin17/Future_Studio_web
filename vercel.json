{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/all-products",
      "destination": "/all-products/index.html"
    },
    {
      "source": "/tvc",
      "destination": "/tvc/index.html"
    },
    {
      "source": "/cartoon-3d",
      "destination": "/cartoon-3d/index.html"
    },
    {
      "source": "/art",
      "destination": "/art/index.html"
    },
    {
      "source": "/showreel",
      "destination": "/showreel/index.html"
    },
    {
      "source": "/team",
      "destination": "/team/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/projects/:projectSlug",
      "destination": "/projects/:projectSlug/index.html"
    },
    {
      "source": "/brands/:brandSlug",
      "destination": "/brands/:brandSlug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
